PORT=4010
# Comma-separated when local + Vercel preview/production domains are both needed.
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4010
DATABASE_URL=postgres://date_user:date_password@localhost:5432/date_platform
UPLOAD_DIR=data/uploads
# Shared with the frontend's INTERNAL_JWT_SECRET. Both sides must use the same value.
# Without it the server trusts forgeable X-Date-User-* headers, so set it before exposing the API.
INTERNAL_JWT_SECRET=
# demo blocks public Toss/KIS live display. Use licensed-live only after data display rights are cleared.
MARKET_DATA_MODE=demo

# Toss Invest Open API
TOSS_INVEST_BASE_URL=https://openapi.tossinvest.com
TOSS_INVEST_CLIENT_ID=
TOSS_INVEST_CLIENT_SECRET=

# Korea Investment & Securities Open API
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_HTS_ID=
KIS_ENABLE_MINUTE_CHARTS=false
