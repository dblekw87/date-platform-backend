PORT=4010
# Comma-separated when local + Vercel preview/production domains are both needed.
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4010
DATABASE_URL=postgres://date_user:date_password@localhost:5432/date_platform
UPLOAD_DIR=data/uploads
# Shared with the frontend's INTERNAL_JWT_SECRET. Both sides must use the same value.
# Without it the server trusts forgeable X-Date-User-* headers, so set it before exposing the API.
INTERNAL_JWT_SECRET=
# demo blocks public Toss/KIS live display. Use licensed-live only after data display rights are cleared.
MARKET_DATA_MODE=demo

# Records price samples and news to the database on a timer while the KR session
# runs (평일 08:00-15:40 KST). Needs DATABASE_URL.
MARKET_COLLECTOR=false

# Toss Invest Open API
TOSS_INVEST_BASE_URL=https://openapi.tossinvest.com
TOSS_INVEST_CLIENT_ID=
TOSS_INVEST_CLIENT_SECRET=

# Korea Investment & Securities Open API
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_HTS_ID=
KIS_ENABLE_MINUTE_CHARTS=false

# Massive (formerly Polygon.io) — whole-market US daily bars for the surge
# candidate model. Read by `npm run us:backfill` only, never during a request.
# Match MASSIVE_REQUESTS_PER_MINUTE to the plan; the free tier allows 5.
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.polygon.io
MASSIVE_REQUESTS_PER_MINUTE=5

# Rebuilds the US surge data once a day: the new session's bars, the quarter's
# SEC filings, the surge labels, and the bucket rates. Checks hourly rather than
# firing at a fixed time, so a laptop that was off overnight catches up whenever
# it is turned on. Needs DATABASE_URL and MASSIVE_API_KEY. Takes 15-20 minutes.
US_PIPELINE=false
# Share counts refreshed per nightly run, oldest first. ~2,300 symbols matter and
# a free key does five a minute, so 250 is about an hour and rotates the whole
# set in a week. Lower it if the nightly run needs to be shorter.
US_PIPELINE_SHARE_SLICE=250
