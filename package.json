{
  "name": "date-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/server.mjs",
    "collector:check": "node scripts/check-collector.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "node --watch src/server.mjs",
    "find": "node scripts/find-symbol.mjs",
    "kr:flags": "node scripts/backfill-kr-symbol-flags.mjs",
    "kr:industry": "node scripts/backfill-kr-industry.mjs",
    "kr:investor-flow": "node scripts/backfill-kr-investor-flow.mjs",
    "kr:ownership": "node scripts/backfill-kr-ownership.mjs",
    "kr:themes": "node scripts/backfill-kr-themes.mjs",
    "probe:nxt-after": "node scripts/probe-nxt-after.mjs",
    "probe:nxt-coverage": "node scripts/probe-nxt-coverage.mjs",
    "start": "node src/server.mjs",
    "test": "node scripts/test-sanitize-html.mjs && node scripts/test-themes.mjs && node scripts/test-session.mjs",
    "test:reasons": "node scripts/test-reasons.mjs",
    "theme:backfill": "node scripts/backfill-sample-themes.mjs",
    "theme:backfill:apply": "node scripts/backfill-sample-themes.mjs --apply",
    "theme:candidates": "node scripts/theme-candidates.mjs",
    "us:backfill": "node scripts/backfill-us-daily.mjs",
    "us:calibrate": "node scripts/calibrate-us-surges.mjs",
    "us:daily": "node scripts/run-us-pipeline.mjs",
    "us:filings": "node scripts/backfill-us-filings.mjs",
    "us:industry": "node scripts/backfill-us-industry.mjs",
    "us:intraday": "node scripts/backfill-us-intraday.mjs",
    "us:label": "node scripts/label-us-surges.mjs",
    "us:listed-shares": "node scripts/backfill-us-listed-shares.mjs",
    "us:reference": "node scripts/backfill-us-reference.mjs",
    "us:short-interest": "node scripts/backfill-us-short-interest.mjs",
    "us:short-volume": "node scripts/backfill-us-short-volume.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=20"
  }
}
